diff --git i/zig/src/server/benchmark_minicpm.zig w/zig/src/server/benchmark_minicpm.zig
new file mode 100644
index 0000000..f7ee32d
--- /dev/null
+++ w/zig/src/server/benchmark_minicpm.zig
@@ -0,0 +1,26 @@
+//! Explicit source-build bridge to a supervised local MiniCPM Python server.
+//! The native benchmark retains its standard suite and HTTP timing implementation.
+const std = @import("std");
+const json = @import("json");
+const Allocator = std.mem.Allocator;
+pub const Info = struct { exe: []const u8, version: []const u8, python: []const u8 };
+
+pub fn detect(a: Allocator, io: std.Io, env: *const std.process.Environ.Map) !?Info {
+    const exe = env.get("TF_MINICPM_MANAGED_ADAPTER") orelse return null;
+    if (!std.fs.path.isAbsolute(exe)) return error.InvalidAdapter;
+    const r = try std.process.run(a, io, .{
+        .argv = &.{exe, "--facts"},
+        .environ_map = env,
+        .stdout_limit = .limited(64 << 10),
+        .stderr_limit = .limited(64 << 10),
+        .timeout = .{ .duration = .{ .raw = .fromSeconds(30), .clock = .awake } },
+    });
+    if (!r.term.success()) return error.InvalidAdapter;
+    const parsed = try json.parse(a, r.stdout);
+    const v = switch (parsed) { .ok => |v| v, .err => return error.InvalidAdapter };
+    const version = (v.get("tensorfold_version") orelse return error.InvalidAdapter).str() orelse return error.InvalidAdapter;
+    const python = (v.get("python_version") orelse return error.InvalidAdapter).str() orelse return error.InvalidAdapter;
+    const kind = (v.get("model_type") orelse return error.InvalidAdapter).str() orelse return error.InvalidAdapter;
+    if (!std.mem.eql(u8, kind, "minicpmv4_7") or !std.mem.eql(u8, version, "0.6.6+mini-managed2") or std.mem.eql(u8, python, "none")) return error.InvalidAdapter;
+    return .{ .exe = exe, .version = version, .python = python };
+}
